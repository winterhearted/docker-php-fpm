[Unit]
Description=PHP-FPM images: check for new upstream patches and rebuild
Documentation=file:%h/php-build/check-updates.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/php-build
# Перед сборкой подтянуть свежие скрипты из репозитория. "-": если сети нет
# или каталог не git-клон (машина ещё на ручной раскладке) — собираем тем,
# что есть, а не валим сборку. --ff-only: локальные правки не мержим молча.
ExecStartPre=-git -C %h/php-build pull --ff-only
ExecStart=%h/php-build/check-updates.sh
# Сборка php с imagick на riscv64 идёт часами — дефолтный старт-таймаут её убьёт
TimeoutStartSec=infinity
# Машины не выделенные под сборку, не мешаем остальному
Nice=10
IOSchedulingClass=idle
